{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ripe-verified-archive-v1"
    },
    "archiveId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "provisional",
                  "unverified"
                ]
              },
              "verifiedBy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "verifiedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "status"
            ],
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "properties": {
                "verifiedBy": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "verifiedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "verifiedBy",
                "verifiedAt"
              ]
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fileName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "checksum": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "fileName",
              "checksum"
            ]
          },
          "plannedDistanceMeters": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100000
          },
          "participants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "athleteId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "attendance": {
                  "enum": [
                    "present",
                    "absent",
                    "unknown"
                  ]
                },
                "completedDistanceMeters": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100000
                },
                "performances": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "resultType": {
                        "enum": [
                          "competition",
                          "test",
                          "training"
                        ]
                      },
                      "distance": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 25000
                      },
                      "stroke": {
                        "enum": [
                          "freestyle",
                          "backstroke",
                          "breaststroke",
                          "butterfly",
                          "individual-medley"
                        ]
                      },
                      "course": {
                        "enum": [
                          "LCM",
                          "SCM"
                        ]
                      },
                      "totalSeconds": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "exclusiveMinimum": 0,
                        "maximum": 86400
                      },
                      "verificationStatus": {
                        "enum": [
                          "verified",
                          "provisional",
                          "unverified"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "resultType",
                      "distance",
                      "stroke",
                      "course",
                      "totalSeconds",
                      "verificationStatus"
                    ]
                  }
                }
              },
              "required": [
                "athleteId",
                "attendance",
                "completedDistanceMeters",
                "performances"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "startsAt",
          "approval",
          "source",
          "plannedDistanceMeters",
          "participants"
        ]
      }
    }
  },
  "required": [
    "format",
    "archiveId",
    "exportedAt",
    "sessions"
  ]
}
